    "./styles.css": "./src/styles.css",
    "./next": {
      "types": "./next.d.mts",
      "default": "./next.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "llms.txt",
    "next.mjs",
    "next.d.mts"
  ],
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs --unit",
    "test:browser": "node scripts/test.mjs --browser",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "check:css": "node scripts/check-css-graph.mjs",
    "check:llms": "node scripts/check-llms.mjs",
    "check:authoring": "node scripts/check-authoring.mjs",
    "check:docs": "node scripts/gen-docs.mjs --check",
    "check:exports": "node scripts/sync-exports.mjs",
    "check:props": "node scripts/gen-props.mjs --check",
    "check:tsconfig": "node scripts/sync-tsconfig.mjs --check",
    "docs:gen": "node scripts/gen-docs.mjs",
    "docs:props": "node scripts/gen-props.mjs",
    "sync:exports": "node scripts/sync-exports.mjs --write",
    "sync:tsconfig": "node scripts/sync-tsconfig.mjs",
    "sync": "pnpm sync:exports && pnpm sync:tsconfig && pnpm docs:gen && pnpm build && pnpm docs:props",
    "verify": "pnpm check:exports && pnpm check:tsconfig && pnpm typecheck && pnpm format:check && pnpm check:css && pnpm check:authoring && pnpm check:docs && pnpm build && pnpm check:llms && pnpm check:props && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build",
    "dev": "cd playground && pnpm dev"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "madge": "^8.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
