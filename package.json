{
  "name": "@zyncat/ui",
  "version": "0.11.0",
  "description": "A React 19 design system: accessible, animated UI components built on a small, closed CSS design-token vocabulary. No Tailwind, no CSS-in-JS.",
  "keywords": [
    "react",
    "react-19",
    "design-system",
    "component-library",
    "react-components",
    "ui-components",
    "ui-kit",
    "design-tokens",
    "css",
    "typescript",
    "accessible",
    "a11y",
    "motion",
    "animation",
    "headless-ui",
    "esm"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Tabsir Ahammed",
  "homepage": "https://ui.zyncat.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tabsir99/zyncat-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Tabsir99/zyncat-ui/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "zyncat-ui-mcp": "./dist/mcp.js"
  },
  "exports": {
