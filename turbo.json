{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**"] },
    "dev": { "cache": false },
    "lint": { "cache": false, "outputs": [] },
    "typecheck": {},
    "format:check": { "cache": false, "outputs": [] },
    "format:fix": { "cache": false, "outputs": [] }
  }
}
