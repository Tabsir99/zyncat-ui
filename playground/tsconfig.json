{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "paths": {
      "premium-ds/button": ["../src/components/button/Button.tsx"],
      "premium-ds/collapse": ["../src/components/motion/Collapse.tsx"],
      "premium-ds/badge": ["../src/components/badge/Badge.tsx"],
      "premium-ds/status-badge": ["../src/components/badge/StatusBadge.tsx"],
      "premium-ds/count-badge": ["../src/components/badge/CountBadge.tsx"],
      "premium-ds/avatar": ["../src/components/avatar/Avatar.tsx"],
      "premium-ds/avatar-group": ["../src/components/avatar/AvatarGroup.tsx"],
      "premium-ds/tag": ["../src/components/tag/Tag.tsx"],
      "premium-ds/toggle-tag": ["../src/components/tag/ToggleTag.tsx"],
      "premium-ds/table": ["../src/components/table/Table.tsx"],
      "premium-ds/pagination": ["../src/components/pagination/Pagination.tsx"],
      "premium-ds/text-field": ["../src/components/input/TextField.tsx"],
      "premium-ds/number-field": ["../src/components/input/NumberField.tsx"],
      "premium-ds/otp-field": ["../src/components/input/OtpField.tsx"],
      "premium-ds/textarea": ["../src/components/textarea/Textarea.tsx"],
      "premium-ds/checkbox": ["../src/components/checkbox/Checkbox.tsx"],
      "premium-ds/toggle": ["../src/components/toggle/Toggle.tsx"],
      "premium-ds/radio-group": ["../src/components/radio-group/RadioGroup.tsx"],
      "premium-ds/select": ["../src/components/select/Select.tsx"],
      "premium-ds/multi-select": ["../src/components/select/MultiSelect.tsx"],
      "premium-ds/date-field": ["../src/components/date-picker/DateField.tsx"],
      "premium-ds/datetime-field": ["../src/components/date-picker/DateTimeField.tsx"],
      "premium-ds/date-range-field": ["../src/components/date-picker/DateRangeField.tsx"],
      "premium-ds/time-field": ["../src/components/date-picker/TimeField.tsx"],
      "premium-ds/tabs": ["../src/components/tabs/Tabs.tsx"],
      "premium-ds/overlay": ["../src/components/overlay/Overlay.tsx"],
      "premium-ds/dialog": ["../src/components/dialog/Dialog.tsx"],
      "premium-ds/tooltip": ["../src/components/tooltip/Tooltip.tsx"],
      "premium-ds/alert": ["../src/components/alert/Alert.tsx"],
      "premium-ds/toast": ["../src/components/toast/Toast.tsx"],
      "premium-ds/toast-store": ["../src/components/toast/toast-store.ts"],
      "premium-ds/motion-tokens": ["../src/tokens/motion-tokens.ts"],
      "premium-ds/styles.css": ["../src/styles.css"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
